{
  "name": "erenvault",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @erenvault/web",
    "dev:api": "npm run dev -w @erenvault/api",
    "build": "npm run build -w @erenvault/web",
    "build:api": "npm run build -w @erenvault/api",
    "lint": "npm run lint -w @erenvault/web",
    "lint:api": "npm run lint -w @erenvault/api",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
